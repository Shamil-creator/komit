[Unit]
Description=Komit Leads API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/komit/backend
EnvironmentFile=/var/www/komit/backend/.env
ExecStart=/usr/bin/node /var/www/komit/backend/src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
